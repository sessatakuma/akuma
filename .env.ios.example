# Copy the needed values to .env.local (git-ignored), or export them in your shell.
APPLE_TEAM_ID=YOURTEAMID
IOS_MARKETING_VERSION=0.1.0
# Choose an unused build number greater than your previous App Store Connect upload.
# IOS_BUILD_NUMBER=2

# Optional: App Store Connect API authentication. Set all three together.
# ASC_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8
# ASC_KEY_ID=YOUR_KEY_ID
# ASC_ISSUER_ID=YOUR_ISSUER_ID

# Optional local device selection.
# IOS_DEVICE_ID=YOUR_IPHONE_UDID
