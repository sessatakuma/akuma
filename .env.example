# Local development environment variables.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# Required. Upstream API key for the /api/mark-accent/stream proxy.
MARK_ACCENT_API_KEY=

# Optional. Overrides the upstream URL for the mark-accent proxy.
# Defaults to https://api.sessatakuma.dev/v1/mark-accent if unset.
# Set only if you need to point at a different upstream instance.
# MARK_ACCENT_UPSTREAM_URL=

# Optional. Cloudflare Web Analytics beacon token (public, build-time).
# Picked up by `next build` and inlined into the layout's beacon script.
# Inlined only when the production host check passes (see src/app/layout.tsx);
# leaving it empty here means the beacon is skipped on `bun dev` and previews,
# which is the intended behaviour.
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional. Microsoft Clarity project ID (public, build-time).
# Picked up by `next build` and inlined into the layout's analytics script.
# Inlined only when the production host check passes (see src/app/layout.tsx);
# leaving it empty here means Clarity is skipped on `bun dev` and previews.
# NEXT_PUBLIC_MS_CLARITY_PROJECT_ID=
